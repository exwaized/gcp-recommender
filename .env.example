# --- Local dev (default): no config needed, WAREHOUSE_BACKEND defaults to sqlite ---

# --- Real deployment on Oracle Cloud ---
WAREHOUSE_BACKEND=oracle
ORACLE_USER=ADMIN
ORACLE_PASSWORD=changeme
# Walletless TLS connect string, from OCI Console > Autonomous Database > DB Connection > TLS tab
# (requires mTLS disabled on the ADB instance — "Allow only TLS connections").
ORACLE_CONNECT_STRING=(description=(retry_count=20)(retry_delay=3)(address=(protocol=tcps)(port=1522)(host=adb.<region>.oraclecloud.com))(connect_data=(service_name=<service_name>))(security=(ssl_server_dn_match=yes)))

# --- API hardening (required in any non-local deployment) ---
# Clients send this in the X-API-Key header. Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=
# Comma-separated browser origins allowed to call the API. Empty = no cross-origin access.
CORS_ALLOW_ORIGINS=
# Local dev only: API_AUTH_DISABLED=1 skips key checks. Never set in production.
